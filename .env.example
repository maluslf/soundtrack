# Copie este ficheiro para ".env" e preencha. Nunca faça commit do .env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Mercado usado nas buscas do Spotify (código ISO do país)
SPOTIFY_MARKET=BR

# Se o Spotify não devolver preview, usa a iTunes Search API (sem chave) como reserva
ITUNES_FALLBACK=true
